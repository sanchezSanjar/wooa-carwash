PORT=3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wooa_carwash?retryWrites=true&w=majority

JWT_SECRET=change_me
JWT_EXPIRES_IN=1d

# First admins: members who register with one of these phones (or emails) become admins.
# After that, admins manage roles in the app (Manage > Members).
ADMIN_PHONES=010-0000-0000
ADMIN_EMAILS=

# SMS (https://solapi.com). Leave empty to run in log-only mode: codes are printed in the server log.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=


# Optional: comma-separated allowed origins for the website (default: allow all)
# CORS_ORIGINS=https://wooa-carwash.com
