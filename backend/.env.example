# Set to production on the real server: it then refuses to start with unsafe settings
# (weak JWT_SECRET, missing SMS keys or CORS_ORIGINS).
NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wooa_carwash?retryWrites=true&w=majority

# Production: a random value of 32+ characters, e.g. openssl rand -hex 32
JWT_SECRET=change_me
# How long a login lasts. Keep it short: logout ends a login at once, but a stolen token works until then.
JWT_EXPIRES_IN=1d

# First admins: members who register with one of these phone numbers (proven by the SMS code) become admins.
# After that, admins manage roles in the app (Manage > Members).
ADMIN_PHONES=010-0000-0000

# SMS (https://solapi.com). Leave empty to run in log-only mode: codes are printed in the server log.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# Payments (collected outside the app). Bills are due on this day of the month (at least 7 days after issue).
PAYMENT_DUE_DAY=10
# Shown in bills and payment reminder SMS
BANK_ACCOUNT=Shinhan 110-000-000000 (Wooa Carwash)

# Weather (Korea Meteorological Administration short-term forecast). Free key from data.go.kr
# ("기상청_단기예보 조회서비스"); paste it as given (already URL-encoded). Empty: weather is skipped.
KMA_SERVICE_KEY=
# KMA grid "nx,ny" of the service area (60,127 = central Seoul), and optional per-apartment grids (JSON)
WEATHER_GRID=60,127
WEATHER_GRIDS=
# Warn members when the daytime chance of rain is at least this (%); also send it by SMS when true
WEATHER_RAIN_POP=60
WEATHER_SMS=false

# Photos uploaded by washers (keep outside the code folder on the server)
UPLOAD_DIR=uploads

# Allowed origins for the website, comma-separated. Required in production.
# CORS_ORIGINS=https://wooa-carwash.com

# Behind nginx (or another proxy): how many proxies are in front, so rate limits see each user's own IP.
# Leave empty when the API is reached directly. Never set more than there really are.
TRUST_PROXY=

# API docs at /docs. On by default locally; in production only when true.
API_DOCS=
